{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "音准镜",
  "mainBinaryName": "voice-pro",
  "version": "0.3.0",
  "identifier": "com.voicepro.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "音准镜",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "publisher": "Voice Pro",
    "shortDescription": "看见每一个音：本地音高对比练唱",
    "longDescription": "导入一首歌，跟着唱，实时看见每个音偏高还是偏低，唱完得到逐句音准报告。所有音频与录音都在本机处理，不上传。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
